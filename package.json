{
  "name": "pi-optimized-render",
  "version": "0.1.0",
  "description": "Retained transcript rendering for long Pi TUI sessions.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tui",
    "performance"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "test:cli": "python3 test/cli-smoke.py",
    "test:cli:history": "python3 test/cli-smoke.py --history",
    "test:package": "node scripts/check-package.mjs",
    "check": "tsc --noEmit && npm run format:check",
    "verify": "npm run check && npm test && npm run test:package",
    "prepublishOnly": "npm run verify",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"bench/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\" \".github/workflows/*.yml\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"bench/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\" \".github/workflows/*.yml\" \"*.json\"",
    "bench": "tsx bench/render.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.19.19",
    "@xterm/headless": "^6.0.0",
    "jiti": "2.7.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
